{
  "info": {
    "_postman_id": "9b2c4a9f-4d2c-4e31-b1d8-6f4c92b6e9f2",
    "name": "Pteris API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin (one time)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin12345\"\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "register" ]
            },
            "description": "Creates the only admin user. If admin already exists returns 409."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin12345\"\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            },
            "description": "Login and set httpOnly cookie `jwt`."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "logout" ]
            },
            "description": "Clears cookie `jwt`."
          }
        },
        {
          "name": "Update Password (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"admin12345\",\n  \"newPassword\": \"adminNEW12345\"\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/update-password",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "update-password" ]
            },
            "description": "Requires logged-in admin cookie."
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "Get All",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "services" ]
            }
          }
        },
        {
          "name": "Get By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "services", ":id" ]
            }
          }
        },
        {
          "name": "Create (admin, multipart)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Service name", "type": "text" },
                { "key": "shortDescription", "value": "Short description", "type": "text" },
                { "key": "longDescription", "value": "Long description", "type": "text" },
                { "key": "features", "value": "[\"feature 1\",\"feature 2\"]", "type": "text" },
                { "key": "icon", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/services",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "services" ]
            },
            "description": "Requires logged-in admin cookie. `features` must be a JSON string array."
          }
        },
        {
          "name": "Update (admin, multipart)",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated name", "type": "text" },
                { "key": "shortDescription", "value": "Updated short", "type": "text" },
                { "key": "longDescription", "value": "Updated long", "type": "text" },
                { "key": "features", "value": "[\"feature A\",\"feature B\"]", "type": "text" },
                { "key": "icon", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/services/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "services", ":id" ]
            },
            "description": "Requires logged-in admin cookie."
          }
        },
        {
          "name": "Delete (admin)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/services/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "services", ":id" ]
            },
            "description": "Requires logged-in admin cookie."
          }
        }
      ]
    },
    {
      "name": "Results",
      "item": [
        {
          "name": "Get All",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/results",
              "host": [ "{{baseUrl}}" ],
