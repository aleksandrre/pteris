        },
        {
          "name": "Get By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/results/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "results", ":id" ]
            }
          }
        },
        {
          "name": "Create (admin, multipart)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "category", "value": "Category", "type": "text" },
                { "key": "client", "value": "Client", "type": "text" },
                { "key": "location", "value": "Location", "type": "text" },
                { "key": "year", "value": "2026", "type": "text" },
                { "key": "plantsCount", "value": "120", "type": "text" },
                { "key": "area", "value": "200m2", "type": "text" },
                { "key": "duration", "value": "2 weeks", "type": "text" },
                { "key": "beforeImage", "type": "file", "src": "" },
                { "key": "afterImage", "type": "file", "src": "" },
                { "key": "images", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/results",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "results" ]
            },
            "description": "Requires logged-in admin cookie. For multiple `images`, add multiple form-data keys named `images`."
          }
        },
        {
          "name": "Update (admin, multipart)",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "category", "value": "Updated Category", "type": "text" },
                { "key": "client", "value": "Updated Client", "type": "text" },
                { "key": "location", "value": "Updated Location", "type": "text" },
                { "key": "year", "value": "2026", "type": "text" },
                { "key": "plantsCount", "value": "200", "type": "text" },
                { "key": "area", "value": "300m2", "type": "text" },
                { "key": "duration", "value": "3 weeks", "type": "text" },
                { "key": "beforeImage", "type": "file", "src": "" },
                { "key": "afterImage", "type": "file", "src": "" },
                { "key": "images", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/results/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "results", ":id" ]
            },
            "description": "Requires logged-in admin cookie. Sending new `images` replaces old images array."
          }
        },
        {
          "name": "Delete (admin)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/results/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "results", ":id" ]
            },
            "description": "Requires logged-in admin cookie."
          }
        }
      ]
    },
